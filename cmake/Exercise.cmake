include(CTest)
find_package(Threads REQUIRED)
set(C100_HELPER_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(c100_exercise nombre)
    add_executable(${nombre} ${ARGN})
    set_target_properties(${nombre} PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED YES C_EXTENSIONS OFF)
    target_include_directories(${nombre} PRIVATE include lib)
    target_link_libraries(${nombre} PRIVATE Threads::Threads m)
    if(APPLE)
        target_compile_definitions(${nombre} PRIVATE _DARWIN_C_SOURCE)
    else()
        target_compile_definitions(${nombre} PRIVATE _GNU_SOURCE)
    endif()
    target_compile_options(${nombre} PRIVATE -Wall -Wextra -Werror -pedantic)

    if(BUILD_TESTING)
        get_filename_component(carpeta "${CMAKE_CURRENT_SOURCE_DIR}" NAME)
        string(SUBSTRING "${carpeta}" 0 3 numero)
        if(numero MATCHES "^0[0-3][0-9]$" OR numero MATCHES "^04[0-2]$")
            if(NOT numero STREQUAL "022" AND NOT numero STREQUAL "025")
                find_package(Python3 REQUIRED COMPONENTS Interpreter)
                add_test(NAME contrato_cli COMMAND "${Python3_EXECUTABLE}" -I
                    "${C100_HELPER_DIR}/../tools/tests/test_cli_exercises.py"
                    "${numero}" "$<TARGET_FILE:${nombre}>")
                set_tests_properties(contrato_cli PROPERTIES TIMEOUT 15)
            endif()
        endif()
        file(GLOB pruebas CONFIGURE_DEPENDS
             "${CMAKE_CURRENT_SOURCE_DIR}/test/test_*.c"
             "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_*.c")
        if(pruebas)
            # Renombrar main solo en el objeto de pruebas permite probar las
            # APIs del ejercicio sin añadir interfaces a la solución.
            add_library(c100_api OBJECT ${ARGN})
            set_target_properties(c100_api PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED YES C_EXTENSIONS OFF)
            target_include_directories(c100_api PRIVATE include lib)
            target_compile_definitions(c100_api PRIVATE main=c100_example_main)
            if(APPLE)
                target_compile_definitions(c100_api PRIVATE _DARWIN_C_SOURCE)
            else()
                target_compile_definitions(c100_api PRIVATE _GNU_SOURCE)
            endif()
            target_compile_options(c100_api PRIVATE -Wall -Wextra -Werror -pedantic -UNDEBUG)
            foreach(prueba IN LISTS pruebas)
                get_filename_component(test_nombre "${prueba}" NAME_WE)
                add_executable(${test_nombre} "${prueba}" $<TARGET_OBJECTS:c100_api>)
                target_include_directories(${test_nombre} PRIVATE include lib)
                target_compile_options(${test_nombre} PRIVATE -Wall -Wextra -Werror -pedantic -UNDEBUG)
                target_link_libraries(${test_nombre} PRIVATE Threads::Threads m)
                if(APPLE)
                    target_compile_definitions(${test_nombre} PRIVATE _DARWIN_C_SOURCE)
                else()
                    target_compile_definitions(${test_nombre} PRIVATE _GNU_SOURCE)
                endif()
                add_test(NAME ${test_nombre} COMMAND ${test_nombre})
                set_tests_properties(${test_nombre} PROPERTIES TIMEOUT 15)
            endforeach()
        endif()
    endif()
endfunction()
